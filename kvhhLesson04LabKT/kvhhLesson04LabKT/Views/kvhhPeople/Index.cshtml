@model IEnumerable<kvhhLesson04LabKT.Models.People>

@{
    ViewData["Title"] = "Thư mục";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                Avatar
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Birthday)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gender)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Name)
                </td>

                <td>
                    @Html.DisplayFor(model => item.Email)
                </td>

                <td>
                    @Html.DisplayFor(model => item.Phone)
                </td>

                <td>
                    @Html.DisplayFor(model => item.Address)
                </td>

                <td>
                    <img src="@item.Avatar" alt="@item.Name" style="width:4rem" />
                </td>

                <td>
                    @Html.DisplayFor(model => item.Birthday)
                </td>

                <td>
                    @Html.DisplayFor(model => item.Bio)
                </td>

                <td>
                    <td>
                        @*@Html.DisplayFor(modelItem => item.Gender)*@
                        @if (item.Gender == 0)
                        {
                            <span>Cty</span>
                        }
                        else if (item.Gender == 1)
                        {
                            <span>Nam</span>
                        }
                        else
                        {
                            <span>Nữ</span>
                        }
                    </td>
                </td>

                <td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.Id /* id=item.PrimaryKey */},
                            new { @class = "btn btn-primary" })
                        @Html.ActionLink("Details", "Details", new { id = item.Id/* id=item.PrimaryKey */},
                            new { @class = "btn btn-success" })
                        @Html.ActionLink("Delete", "Delete", new { id = item.Id/* id=item.PrimaryKey */},
                            new { @class = "btn btn-danger" })
                    </td>
                </td>
            </tr>
        }
    </tbody>
</table>