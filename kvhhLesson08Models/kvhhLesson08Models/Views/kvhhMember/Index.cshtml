@model IEnumerable<kvhhLesson08Models.Models.kvhhMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card p-3">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="kvhhCreate">Thêm mới</a>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.kvhhMemberId)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.kvhhUserName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.kvhhPassword)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.kvhhFullName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.kvhhEmail)
                    </th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.kvhhMemberId)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.kvhhUserName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.kvhhPassword)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.kvhhFullName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.kvhhEmail)
                        </td>
                        <td>
                            @Html.ActionLink("Sửa", "kvhhEdit", new { id = item.kvhhMemberId }) |
                            @Html.ActionLink("Xem chi tiết", "kvhhDetails", new { id = item.kvhhMemberId }) |
                            @Html.ActionLink("Xóa", "kvhhDelete", new { id = item.kvhhMemberId })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>